<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.zhou</groupId>
	<artifactId>japanese-learning</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>japanese-learning</name>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>17</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!--
			SQLite JDBCドライバ。
			JPA(Hibernate)は最終的にJDBC経由でDBへ接続するため、SQLite用のドライバが必須。
			本ライブラリはSQLiteエンジン本体も同梱しているため、端末へ別途SQLiteをインストールする必要はない。
			バージョンはSpring Bootの依存関係管理(BOM)に従うため記載しない。
		-->
		<dependency>
			<groupId>org.xerial</groupId>
			<artifactId>sqlite-jdbc</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!--
			Hibernate用SQLite方言(Dialect)。
			Dialectは「どのDB向けのSQLを生成するか」をHibernateに教える部品。
			Hibernate本体はSQLite用Dialectを持たず、コミュニティ版のこのライブラリに含まれている。
			バージョンはSpring Bootが管理するHibernateのバージョンに合わせて自動解決される。
		-->
		<dependency>
			<groupId>org.hibernate.orm</groupId>
			<artifactId>hibernate-community-dialects</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!--
				V1通常利用時の画面配信用。
				frontend で事前にビルドした成果物(frontend/dist)を、JAR作成直前(prepare-package)に
				target/classes/static へコピーする。Spring Boot は classpath:/static/ のファイルを自動で配信するため、
				JARを起動するだけで画面(Vue)とREST APIを同じ http://localhost:8080 から利用できる。
				・npm のビルドはMavenから実行しない(package 前に frontend で npm run build を実行しておく)
				・frontend/dist が存在しない場合は何もコピーされない(テストやJAR作成自体は失敗しない)
				・コピー先は target 配下のため、生成物が src やGitに混ざらない
				maven-resources-plugin はMaven標準のプラグインで、バージョンはSpring Bootの親POMで管理されている。
			-->
			<plugin>
				<artifactId>maven-resources-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-frontend-dist</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
							<resources>
								<resource>
									<directory>${project.basedir}/../frontend/dist</directory>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
